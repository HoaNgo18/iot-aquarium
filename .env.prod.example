COMPOSE_PROJECT_NAME=aquasense

# Home server / Cloudflare Tunnel (default example). For a public VPS use:
# COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.vps.yaml
COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.tunnel.yaml

# Remotely-managed tunnel token from Cloudflare Zero Trust. Never commit a real token.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
APP_DOMAIN=app.dreamer02.id.vn
MQTT_DOMAIN=mqtt.dreamer02.id.vn

# VPS/Caddy mode only. Use localhost only for the local TLS test.
DOMAIN=aquasense.example.com
ACME_EMAIL=admin@example.com
# Leave empty for public Let's Encrypt. Set to "tls internal" only for local testing.
CADDY_TLS_MODE=

POSTGRES_DB=aquasense
POSTGRES_USER=aquasense
POSTGRES_PASSWORD=replace-with-openssl-rand-value
SECRET_KEY=replace-with-openssl-rand-value

# Must match the password assigned to the Mosquitto user "backend".
MQTT_BACKEND_PASSWORD=replace-with-mqtt-backend-password
